# Copie este arquivo para .env (o .env NÃO vai para o repositório: está no .gitignore).
# Valores de EXEMPLO para o PORTAL SIMULADO local (127.0.0.1:5050). Não são senhas reais.
# O robô e o portal simulado leem o mesmo .env, então funcionam com estes valores;
# troque-os por valores seus antes de usar fora da demonstração.
PORTAL_USUARIO=operador_teste
PORTAL_SENHA=troque-esta-senha
PORTAL_API_TOKEN=troque-este-token
PORTAL_CHAVE_SESSAO=troque-esta-chave-de-sessao
